<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:simpleType name="tipoIdEquipo">
    <xs:restriction base="xs:string">
      <xs:pattern value="EQ-[0-9]{2}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tipoDispositivo">
    <xs:restriction base="xs:string">
      <xs:enumeration value="router"/>
      <xs:enumeration value="switch"/>
      <xs:enumeration value="punto_acceso"/>
      <xs:enumeration value="servidor"/>
      <xs:enumeration value="firewall"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tipoIPv4">
    <xs:restriction base="xs:string">
      <xs:pattern value="((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tipoMAC">
    <xs:restriction base="xs:string">
      <xs:pattern value="([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="tipoEquipo">
    <xs:sequence>
      <xs:element name="nombre" type="xs:string"/>
      <xs:element name="modelo" type="xs:string"/>
      <xs:element name="ip" type="tipoIPv4"/>
      <xs:element name="mac" type="tipoMAC"/>
      <xs:element name="ubicacion" type="xs:string"/>
      <xs:element name="fechaCompra" type="xs:date"/>
    </xs:sequence>
    <xs:attribute name="id" type="tipoIdEquipo" use="required"/>
    <xs:attribute name="tipo" type="tipoDispositivo" use="required"/>
    <xs:attribute name="activo" type="xs:boolean" use="required"/>
  </xs:complexType>

  <xs:element name="inventario">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="equipo" type="tipoEquipo" minOccurs="5" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="aula" type="xs:string" use="required"/>
      <xs:attribute name="centro" type="xs:string" use="required"/>
      <xs:attribute name="actualizado" type="xs:date" use="required"/>
    </xs:complexType>
    <xs:unique name="idEquipoUnico">
      <xs:selector xpath="equipo"/>
      <xs:field xpath="@id"/>
    </xs:unique>
  </xs:element>

</xs:schema>
